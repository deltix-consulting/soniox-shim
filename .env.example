SONIOX_API_KEY=            # required
SONIOX_MODEL=stt-async-v5
LANGUAGE_HINTS=            # e.g. nl,en — request `language` is added in front
SHIM_API_TOKEN=            # optional; if set, callers must send Authorization: Bearer <token>
SONIOX_TIMEOUT_S=25        # keep below the caller's request timeout (Vexa: 30s)
LOG_LEVEL=INFO
